{
  "name": "demios-pos",
  "version": "1.0.0",
  "description": "Restaurant Point of Sale System",
  "author": "Your Company",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').mkdirSync('.tmp-build',{recursive:true})\"",
    "build": "cross-env ELECTRON_BUILD=true TMP=./.tmp-build TEMP=./.tmp-build next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "node -e \"const fs=require('fs');for(const d of ['.next','.tmp-build'])try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}\"",
    "electron": "electron .",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "electron-build-simple": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "electron-portable": "npm run build && electron-builder --win portable",
    "electron-pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "electron-dist": "electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/supabase-js": "^2.98.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.yourcompany.pos",
    "productName": "POS System",
    "directories": {
      "output": "electron-dist",
      "buildResources": "public"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!.next/**/*",
      "!dist/**/*",
      "!.git/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS System",
      "installerIcon": "public/icons/icon.ico",
      "uninstallerIcon": "public/icons/icon.ico",
      "perMachine": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icons/icon-512x512.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/icon-512x512.png",
      "category": "Office"
    }
  }
}
